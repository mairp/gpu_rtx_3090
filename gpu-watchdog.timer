# gpu-watchdog.timer — poll RTX 3090 health every 30s. The watchdog is cheap
# (an nvidia-smi -L probe) and idempotent; a persistent flag file + metric mean
# a missed tick just delays detection by one interval, never loses state.
#
# 30s matches the roadmap's "poll during agent runs" cadence. If you want the
# poll active ONLY during agent runs (not 24/7), start/stop this timer from the
# bebop team entrypoint instead of enabling it globally.
[Unit]
Description=Poll RTX 3090 watchdog every 30s

[Timer]
OnBootSec=30
OnUnitActiveSec=30
AccuracySec=5s
Unit=gpu-watchdog.service

[Install]
WantedBy=timers.target
